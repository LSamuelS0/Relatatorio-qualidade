rules_version = '2';

// Regras de acesso do Relatório da Qualidade.
// Colar em: Firebase → Firestore Database → Regras → Publicar.
//
// - Cada pessoa lê e grava só os próprios relatórios, rascunhos e fotos.
// - O administrador (conta ADM) lê, edita e apaga tudo.
// - "compartilhado/ultimoBloqueio": qualquer pessoa logada lê e atualiza
//   (botão "Puxar último bloqueio" da troca de turno).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.uid == "Rxejtj0jgEUEGfTup3yK9ngMvtH3";
    }
    function ownsExisting() {
      return signedIn() && resource.data.owner == request.auth.uid;
    }
    function ownsNew() {
      return signedIn() && request.resource.data.owner == request.auth.uid;
    }

    match /relatorios/{id} {
      allow read: if isAdmin() || ownsExisting();
      allow create: if isAdmin() || ownsNew();
      allow update: if isAdmin() || (ownsExisting() && ownsNew());
      allow delete: if isAdmin() || ownsExisting();
    }

    match /rascunhos/{id} {
      allow read: if isAdmin() || ownsExisting();
      allow create: if isAdmin() || ownsNew();
      allow update: if isAdmin() || (ownsExisting() && ownsNew());
      allow delete: if isAdmin() || ownsExisting();
    }

    match /fotos/{id} {
      allow read: if isAdmin() || ownsExisting();
      allow create: if isAdmin() || (ownsNew() && request.resource.data.data.size() < 1000000);
      allow update: if isAdmin() || (ownsExisting() && ownsNew());
      allow delete: if isAdmin() || ownsExisting();
    }

    match /compartilhado/ultimoBloqueio {
      allow read, write: if signedIn();
    }

    // Ocorrências da linha: todas as pessoas logadas veem (acompanhamento diário);
    // cada um lança as suas; quem lançou ou o ADM pode apagar.
    match /ocorrencias/{id} {
      allow read: if signedIn();
      allow create: if ownsNew();
      allow update, delete: if isAdmin() || ownsExisting();
    }

    // Fotos das ocorrências: todas as pessoas logadas veem (abrem a ocorrência no
    // "Ocorrências do dia"); cada um envia as suas; quem enviou ou o ADM apaga.
    match /fotosOcorrencias/{id} {
      allow read: if signedIn();
      allow create: if ownsNew() && request.resource.data.data.size() < 1000000;
      allow update, delete: if isAdmin() || ownsExisting();
    }

    // Cadastro da Injetora (quais peças rodam em cada máquina): todos leem, só o ADM altera.
    match /cadastro/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /usuarios/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }
  }
}
